# ─────────────────────────────────────────────────────────────────────────────
# ModVerse environment configuration (copy to .env.local — never commit it).
# EVERYTHING here is optional: ModVerse runs fully locally with no variables set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Local data directory (embedded PostgreSQL via PGlite, uploads, generated keys).
MODVERSE_DATA_DIR=.data
# Use an external PostgreSQL instead of the embedded database (e.g. Docker / Neon / RDS).
# DATABASE_URL=postgres://modverse:modverse@localhost:5432/modverse
# DATABASE_POOL_MAX=10
# Apply migrations / reference seed automatically on first connection (default true).
# MODVERSE_AUTO_MIGRATE=true
# MODVERSE_AUTO_SEED=true

# 32-byte base64 key used to encrypt integration credentials at rest.
# If unset, a key is generated at .data/secret.key on first use.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MODVERSE_SECRET_KEY=

# Salt for hashing client IPs in audit logs (set a random value in production).
# MODVERSE_IP_SALT=

# First admin account. If unset, random credentials are written to .data/ADMIN_CREDENTIALS.txt
# ADMIN_EMAIL=admin@yourdomain.in
# ADMIN_PASSWORD=
# Create demo staff/customer accounts on first run (default true; set false in production).
# MODVERSE_DEMO_ACCOUNTS=true

# One-click guest accounts on the sign-in pages (default on for local use). Set to false for public deployments.
# MODVERSE_GUEST_MODE=true

# The live camera trial room is hidden while it is reworked. Set true to serve it at /try-on/live.
# MODVERSE_LIVE_TRYON=false

# Optional: USDC (binary USD) export. Python with OpenUSD installed (pip install usd-core), e.g. /opt/usd/bin/python3.
# Without it, the USDC button explains that USDZ / USD should be used instead.
# MODVERSE_USD_PYTHON=

# Behind a reverse proxy: trust X-Forwarded-For for rate limiting.
# TRUST_PROXY=false
# Extra allowed origins for state-changing API requests (comma-separated).
# MODVERSE_ALLOWED_ORIGINS=

# ── Optional integrations ────────────────────────────────────────────────────
# Credentials are normally entered in Admin → Integration Manager (encrypted in DB).
# Env vars below only PRE-FILL credentials; a provider is never active until an
# admin runs a successful connection test and explicitly enables it.

# AI — local
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# AI — hosted (billable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# Meta Muse Image (AI artwork generation; billed per image by Meta). Put your key here OR paste it in
# Admin → Integrations (stored encrypted). Never commit a real key. Still needs Test + Enable by an admin.
# META_MUSE_API_KEY=
# META_MUSE_BASE_URL=https://api.meta.ai/v1
# META_MUSE_MODEL=muse-image-1.0
# META_MUSE_REASONING=low

# Google Gemini API (Fashion Director) — free tier + paid usage; review data-use terms first.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Gemini Nano (Chrome built-in, on-device) needs no key — customers opt in inside the editor.

# AI evaluation harness (npm run ai:eval) — model providers are called ONLY when these are set.
# EVAL_OLLAMA_URL=http://127.0.0.1:11434
# EVAL_OLLAMA_MODEL=llama3.1:8b
# EVAL_GEMINI_KEY=
# EVAL_GEMINI_MODEL=gemini-2.5-flash
# EVAL_OPENAI_KEY=
# EVAL_OPENAI_MODEL=gpt-4.1-mini

# Authentication
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
# APPLE_SIGNIN_SERVICES_ID=
# APPLE_SIGNIN_TEAM_ID=
# APPLE_SIGNIN_KEY_ID=
# APPLE_SIGNIN_PRIVATE_KEY=

# Payments — use TEST keys (rzp_test_…) first
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Shipping
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_PINCODE=

# Storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Communication
# RESEND_API_KEY=
# RESEND_FROM="ModVerse <hello@yourdomain.in>"
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Other
# GOOGLE_MAPS_API_KEY=
# POSTHOG_PROJECT_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# SENTRY_DSN=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# REDIS_URL=redis://localhost:6379

# ── Tooling (scripts only, never read by the app) ────────────────────────────
# Base URL probed by `npm run perf` (a running production build).
# PERF_BASE_URL=http://localhost:3200
