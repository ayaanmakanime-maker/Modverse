# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# local data (database, uploads, generated keys) — never commit
.data/
uploads/

# environment & secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# testing
coverage/
playwright-report/
test-results/
blob-report/

# misc
.DS_Store
npm-debug.log*
.vercel

# local computer-vision runtime & models (npm run models:fetch)
public/mediapipe/
public/models/


# asset pipeline download cache (re-created by npm run assets:acquire)
.cache/
asset-inbox/
public/garment-library/**/original/
